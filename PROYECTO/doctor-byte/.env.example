# Variables de entorno de Doctor Byte
# Copiar este archivo como .env y completar los valores reales.
# El archivo .env nunca debe subirse al repositorio.

# Token del bot de Telegram obtenido desde @BotFather
TELEGRAM_TOKEN=tu_token_aqui

# Chat ID del destinatario de las notificaciones
# Para obtenerlo: escribirle a @userinfobot en Telegram
TELEGRAM_CHAT_ID=tu_chat_id_aqui
